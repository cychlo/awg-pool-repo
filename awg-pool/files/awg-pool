#!/bin/sh
# =============================================================================
# awg-pool 1.3.2 -- пул AWG-интерфейсов OpenWrt: ротация стран по скорости
# OpenWrt 25.12.x, Forkop 2.0 (группа Fallback над интерфейсами секции)
#
# Forkop Fallback -- доступность и мгновенное переключение между интерфейсами
# этот скрипт     -- выбор страны по реальной скорости, разнообразие пула,
#                    обслуживание резервов; конфигурацию Forkop НЕ трогает
#
# Инварианты:
#   * поднят ровно каждый интерфейс пула, ни одного лишнего (слоты провайдера)
#   * у каждого интерфейса ровно один peer, свой клиентский ключ, свой Address
#   * страны у членов пула не повторяются (проверяется и на старте)
#   * при штатном выходе ни один интерфейс не остаётся погашенным
#   * если не отвечает НИ ОДИН интерфейс -- перебор не запускается (защита
#     от ложного отказа при блокировке проверочных адресов через DPI)
#   * медленный, но живой сервер отбраковывается по НЕЗАВИСИМОМУ счётчику
#     неудачных замеров скорости: health-успех его не сбрасывает
#   * недоступность узла замера скорости (код 000 / ошибка HTTP) -- это НЕ
#     «медленный сервер»: такой замер пропускается и счётчик не увеличивает
#   * WAN проверяется отдельными адресами (wan_urls), не health_urls:
#     блокировка DoH-адресов на голом WAN не останавливает демон;
#     отсутствие default-маршрута в main -- отказ WAN
#   * если перебор не нашёл годной страны, интерфейсу возвращается прежняя
#   * при старте снимаются устаревшие проверочные правила прошлых запусков
# =============================================================================
VERSION="1.3.2"
CFG="awg-failover"
LOG_TAG="awg-pool"

CHECK_INTERVAL=20
FAIL_THRESHOLD=3
SPEED_FAIL_THRESHOLD=2
HEALTH_TIMEOUT=5
HEALTH_TRIES=3
HEALTH_RETRY=2
SPEED_EVERY=30
SPEED_BYTES=2000000
SPEED_WINDOW=8
MIN_SPEED_KBPS=200
SPEED_HOST="speed.cloudflare.com"
SPEED_IP_FIXED=""
TLS_MAX="1.2"
CROSS_CHECK=1
HEALTH_URLS="https://8.8.8.8/resolve?name=example.com&type=A https://8.8.4.4/resolve?name=example.com&type=A https://1.1.1.1/cdn-cgi/trace"
WAN_URLS="http://www.msftconnecttest.com/connecttest.txt http://detectportal.firefox.com/success.txt"
SWEEP_COOLDOWN=90
DEAD_TTL=600
STANDBY_EVERY=15
STANDBY_THRESHOLD=2
MAX_TRIES=4
PROBE_CHECK_EVERY=5
WAN_REFRESH_EVERY=15
STATE="/var/run/awg-pool.state"
LOCK="/var/run/awg-pool.lock"
POOL_MAX=8   # проверочных приоритетов ровно 8 (200..221), лимит размера пула
PROBE_TABLES="250 251 252 240 241 242 9990 9991 9992"
PROBE_PRIOS="200 201 202 210 211 212 220 221"

POOL=""; POOL_N=0; SERVERS=""; SERVER_N=0; POOL_IFACES=""
SPEED_IP=""; WAN_CACHED=""; RUNNING=1; NAP_PID=""; QUIET=0; LAST_SPEED=0
FAILS=0; SFAILS=0
TLS_FLAGS="--tls-max 1.2"
ROTATE_EXCL_SELF=0   # 1 -- ручной --rotate: текущую страну интерфейса не выбирать
CFG_REASON=""        # причина, по которой load_config вернул 1 (пул не настроен)

_lg() {
    logger -t "$LOG_TAG" -p "daemon.$1" "$3" 2>/dev/null
    [ "$QUIET" = 1 ] || printf '%s [%s] %s\n' "$(date '+%F %T')" "$2" "$3"
}
log() { _lg info INFO "$*"; }
logw() { _lg warn WARN "$*"; }
loge() { _lg err ERROR "$*"; }
die() { loge "$*"; exit 1; }
is_num() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }
valid_name() { case "$1" in ''|*[!A-Za-z0-9_]*) return 1 ;; *) return 0 ;; esac; }
# host из конфига попадает в uci batch: только безопасные символы (имя, IPv4, IPv6)
valid_host() { case "$1" in ''|*[!A-Za-z0-9._:-]*) return 1 ;; *) return 0 ;; esac; }
valid_port() { is_num "$1" && [ "${#1}" -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

sections_of() { uci -q show "$1" 2>/dev/null | sed -n "s/^$1\.\(.*\)=$2\$/\1/p"; }
nth() { printf '%s\n' "$1" | sed -n "$(($2 + 1))p"; }
count_lines() { printf '%s' "$1" | grep -c '^'; }
pget() { uci -q get "network.$1.$2" 2>/dev/null; }
sget() { uci -q get "$CFG.$1.$2" 2>/dev/null; }

load_config() {
    CFG_REASON=""
    if uci -q get "$CFG.main" >/dev/null 2>&1; then
        for _p in CHECK_INTERVAL:check_interval FAIL_THRESHOLD:fail_threshold \
                  SPEED_FAIL_THRESHOLD:speed_fail_threshold \
                  HEALTH_TIMEOUT:health_timeout HEALTH_TRIES:health_tries \
                  HEALTH_RETRY:health_retry SPEED_EVERY:speed_every \
                  SPEED_BYTES:speed_bytes SPEED_WINDOW:speed_window \
                  MIN_SPEED_KBPS:min_speed_kbps SPEED_HOST:speed_host \
                  SPEED_IP_FIXED:speed_ip TLS_MAX:tls_max CROSS_CHECK:cross_check \
                  HEALTH_URLS:health_urls WAN_URLS:wan_urls SWEEP_COOLDOWN:sweep_cooldown \
                  DEAD_TTL:dead_ttl STANDBY_EVERY:standby_every MAX_TRIES:max_tries \
                  PROBE_CHECK_EVERY:probe_check_every WAN_REFRESH_EVERY:wan_refresh_every; do
            _v="${_p%%:*}"; _o="${_p##*:}"
            _val="$(uci -q get "$CFG.main.$_o" 2>/dev/null)"
            [ -n "$_val" ] && eval "$_v=\$_val"
        done
    fi
    # Числа: только цифры, не длиннее 9 знаков; ведущие нули срезаются
    # (в арифметике busybox ash «08» трактуется как неверное восьмеричное).
    for _nv in CHECK_INTERVAL FAIL_THRESHOLD SPEED_FAIL_THRESHOLD HEALTH_TIMEOUT \
               HEALTH_TRIES HEALTH_RETRY SPEED_EVERY SPEED_BYTES SPEED_WINDOW \
               MIN_SPEED_KBPS SWEEP_COOLDOWN DEAD_TTL STANDBY_EVERY MAX_TRIES \
               PROBE_CHECK_EVERY WAN_REFRESH_EVERY CROSS_CHECK; do
        eval "_nval=\$$_nv"
        if ! is_num "$_nval" || [ "${#_nval}" -gt 9 ]; then
            loge "Некорректное число в $CFG.main ($_nv): '$_nval'"
            return 1
        fi
        _nval="$(printf '%s' "$_nval" | sed 's/^0*\([0-9]\)/\1/')"
        eval "$_nv=\$_nval"
    done
    case "$TLS_MAX" in
        auto|1.2|1.3) : ;;
        *) loge "tls_max должен быть auto|1.2|1.3 (TLS 1.0/1.1 запрещены RFC 8996 и не поддерживаются mbedTLS)"; return 1 ;;
    esac
    case "$SPEED_HOST" in
        ''|*[!A-Za-z0-9.-]*) loge "speed_host: недопустимые символы"; return 1 ;;
    esac
    if [ -n "$SPEED_IP_FIXED" ]; then
        case "$SPEED_IP_FIXED" in
            *[!0-9.]*) loge "speed_ip должен быть IPv4-адресом"; return 1 ;;
        esac
    fi
    TLS_FLAGS=""
    [ "$TLS_MAX" = auto ] || TLS_FLAGS="--tls-max $TLS_MAX"
    # mbedTLS 3.x: TLS 1.0/1.1 удалены (RFC 8996), TLS 1.3 зависит от сборки.
    if [ "$TLS_MAX" = 1.3 ] && curl -V 2>/dev/null | grep -qi mbedtls; then
        logw "curl с mbedTLS: поддержка TLS 1.3 зависит от сборки; если проверки не проходят -- tls_max=1.2"
    fi
    # Нижние границы: значения 0 через `uci set` (мимо LuCI) ломали бы логику
    # (health_tries=0 -- ни одна страна не проходит проверку, max_tries=0 --
    # ни одна не пробуется, speed_window/health_timeout=0 -- «без лимита» в curl).
    [ "$CHECK_INTERVAL" -ge 5 ] || CHECK_INTERVAL=5
    [ "$FAIL_THRESHOLD" -ge 1 ] || FAIL_THRESHOLD=1
    [ "$SPEED_FAIL_THRESHOLD" -ge 1 ] || SPEED_FAIL_THRESHOLD=1
    [ "$HEALTH_TIMEOUT" -ge 1 ] || HEALTH_TIMEOUT=1
    [ "$HEALTH_TRIES" -ge 1 ] || HEALTH_TRIES=1
    [ "$MAX_TRIES" -ge 1 ] || MAX_TRIES=1
    [ "$SPEED_WINDOW" -ge 2 ] || SPEED_WINDOW=2
    [ "$SPEED_BYTES" -ge 100000 ] || SPEED_BYTES=100000
    [ "$PROBE_CHECK_EVERY" -ge 1 ] || PROBE_CHECK_EVERY=1
    [ "$WAN_REFRESH_EVERY" -ge 1 ] || WAN_REFRESH_EVERY=1
    POOL="$(sections_of "$CFG" pool)"; POOL_N="$(count_lines "$POOL")"
    SERVERS="$(sections_of "$CFG" server)"; SERVER_N="$(count_lines "$SERVERS")"
    [ "$POOL_N" -ge 1 ] || { CFG_REASON="не задано ни одной секции pool"; return 1; }
    [ "$SERVER_N" -ge 2 ] || { CFG_REASON="нужно минимум две секции server"; return 1; }
    return 0
}

pool_iface() { sget "$(nth "$POOL" "$1")" iface; }
srv_host() { sget "$(nth "$SERVERS" "$1")" host; }
srv_port() { _sp="$(sget "$(nth "$SERVERS" "$1")" port)"; printf '%s' "${_sp:-443}"; }

peer_type() {
    for _pt in "amneziawg_$1" "wireguard_$1"; do
        if uci -q show network 2>/dev/null | grep -q "=$_pt\$"; then printf '%s' "$_pt"; return 0; fi
    done
    return 1
}
# Кэш PR_* наполняется вызывающим в основной оболочке (set_pr "$if" "$(peer_ref "$if")"),
# т.к. сам peer_ref всегда вызывается через $(...) и его присваивания не переживают subshell.
# Кэш заполняется в preflight; смена/переименование peer-секций требует перезапуска службы.
set_pr() { eval "PR_$1=\$2"; }
get_pr() { eval "printf '%s' \"\${PR_$1:-}\""; }
peer_ref() {
    _c="$(get_pr "$1")"
    [ -n "$_c" ] && { printf '%s' "$_c"; return 0; }
    _t="$(peer_type "$1")" || return 1
    _c="$(sections_of network "$_t" | head -n1)"
    [ -n "$_c" ] || return 1
    printf '%s' "$_c"
}
peer_count() { _pc="$(peer_type "$1")" || { echo 0; return; }; count_lines "$(sections_of network "$_pc")"; }
cur_host() { pget "$(peer_ref "$1")" endpoint_host; }

used_hosts() {
    _uh=0
    while [ "$_uh" -lt "$POOL_N" ]; do
        [ "$1" = "$(pool_iface "$_uh")" ] || cur_host "$(pool_iface "$_uh")"
        _uh=$((_uh + 1))
    done
}

iface_addr() { ip -4 -o addr show dev "$1" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1; }
tbl_for() { ip rule show 2>/dev/null | sed -n "s/.*oif $1 .*lookup \([0-9][0-9]*\).*/\1/p" | head -n1; }
set_pt() { eval "PT_$1=\$2"; }
get_pt() { eval "printf '%s' \"\${PT_$1:-}\""; }
set_pp() { eval "PP_$1=\$2"; }
get_pp() { eval "printf '%s' \"\${PP_$1:-}\""; }
set_sf() { eval "SF_$1=\$2"; }
get_sf() { eval "printf '%s' \"\${SF_$1:-0}\""; }

# Есть ли правило «oif $1 lookup $2» (с границей слова: awg1 != awg10, 25 != 250)
rule_has() { ip rule show 2>/dev/null | grep -Eq "oif $1[[:space:]].*lookup $2([[:space:]]|\$)"; }

# Все счётчики/переменные pick_probe имеют префикс _pk_: функция вызывается
# напрямую (не через $(...)) и не должна затирать переменные вызывающего.
# Таблица и приоритет выбираются независимо: если одно из значений уже есть,
# а второго нет, дочищается только недостающее.
pick_probe() {
    _pkif="$1"
    if [ -z "$(get_pt "$_pkif")" ]; then
        _pkused="$( { cat /etc/iproute2/rt_tables 2>/dev/null; cat /etc/iproute2/rt_tables.d/* 2>/dev/null; } | awk '$1 ~ /^[0-9]+$/ {print $1}' )"
        _pki=0
        while [ "$_pki" -lt "$POOL_N" ]; do
            _pko="$(pool_iface "$_pki")"
            [ "$_pko" = "$_pkif" ] || _pkused="$_pkused
$(get_pt "$_pko")"
            _pki=$((_pki + 1))
        done
        for _pkt in $PROBE_TABLES; do
            printf '%s\n' "$_pkused" | grep -qx "$_pkt" && continue
            [ -n "$(ip route show table "$_pkt" 2>/dev/null)" ] && continue
            set_pt "$_pkif" "$_pkt"; break
        done
        [ -n "$(get_pt "$_pkif")" ] || return 1
    fi
    [ -n "$(get_pp "$_pkif")" ] && return 0
    _pkrules="$(ip rule show 2>/dev/null)"
    for _pkp in $PROBE_PRIOS; do
        printf '%s\n' "$_pkrules" | grep -q "^$_pkp:" && continue
        _pki=0; _pktaken=0
        while [ "$_pki" -lt "$POOL_N" ]; do
            _pko="$(pool_iface "$_pki")"
            [ "$(get_pp "$_pko")" = "$_pkp" ] && _pktaken=1
            _pki=$((_pki + 1))
        done
        [ "$_pktaken" = 1 ] && continue
        set_pp "$_pkif" "$_pkp"; return 0
    done
    return 1
}
# Снимает проверочные правила/таблицы интерфейсов пула, оставшиеся от прошлых
# запусков (SIGKILL, OOM, падение). Трогаются ТОЛЬКО правила с нашими
# приоритетами и нашими таблицами: чужая политика маршрутизации не затрагивается.
probe_cleanup() {
    for _pcif in $POOL_IFACES; do
        # список правил снимается ДО удаления: не читаем и не меняем таблицу правил одновременно
        _pcrules="$(ip rule show 2>/dev/null)"
        printf '%s\n' "$_pcrules" | sed -n "s/^\([0-9][0-9]*\):.*oif $_pcif .*lookup \([0-9][0-9]*\).*/\1 \2/p" | \
        while read -r _pcp _pct; do
            case " $PROBE_PRIOS " in *" $_pcp "*) : ;; *) continue ;; esac
            case " $PROBE_TABLES " in *" $_pct "*) : ;; *) continue ;; esac
            ip rule del oif "$_pcif" lookup "$_pct" priority "$_pcp" 2>/dev/null
            ip route flush table "$_pct" 2>/dev/null
        done
    done
    return 0
}
probe_up() {
    _qupif="$1"; pick_probe "$_qupif" || return 1
    _qupt="$(get_pt "$_qupif")"; _qupp="$(get_pp "$_qupif")"; _qupa="$(iface_addr "$_qupif")"
    [ -n "$_qupa" ] || return 1
    [ -n "$_qupp" ] || return 1
    ip route replace default dev "$_qupif" src "$_qupa" table "$_qupt" 2>/dev/null || return 1
    if ! rule_has "$_qupif" "$_qupt"; then
        ip rule del oif "$_qupif" lookup "$_qupt" 2>/dev/null
        ip rule add oif "$_qupif" lookup "$_qupt" priority "$_qupp" 2>/dev/null || return 1
    fi
    return 0
}
probe_down() {
    _qdif="$1"; _qdt="$(get_pt "$_qdif")"
    [ -n "$_qdt" ] || return 0
    ip rule del oif "$_qdif" lookup "$_qdt" 2>/dev/null
    ip route flush table "$_qdt" 2>/dev/null
    return 0
}
probe_ok() {
    _qoif="$1"; _qot="$(get_pt "$_qoif")"
    [ -n "$_qot" ] || return 1
    rule_has "$_qoif" "$_qot" || return 1
    ip route show table "$_qot" 2>/dev/null | grep -Eq "dev $_qoif([[:space:]]|\$)" || return 1
    return 0
}

# WAN_CACHED обновляется в основной оболочке (цикл демона, wan_refresh_every),
# здесь -- только чтение кэша либо разовый пересчёт.
wan_dev() {
    [ -n "$WAN_CACHED" ] && { printf '%s' "$WAN_CACHED"; return 0; }
    ip -4 route show table main 2>/dev/null | awk '/^default/ {for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}'
}
wan_refresh() {
    WAN_CACHED="$(ip -4 route show table main 2>/dev/null | awk '/^default/ {for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')"
}
# WAN проверяется ОТДЕЛЬНЫМИ адресами (wan_urls, по умолчанию -- captive-portal
# проверки по HTTP): health_urls (DoH по IP) могут быть заблокированы на голом
# WAN, и это не должно выглядеть как отказ WAN.
# set -f вокруг циклов по URL: в адресах есть '?', исключаем globbing
wan_ok() {
    _wok="$(wan_dev)"
    # Нет default-маршрута в main -- это упавший WAN (кабель, PPPoE, ранняя
    # загрузка), а не «default ушёл в туннель»: туннельный случай ниже
    # распознаётся по имени устройства из POOL_IFACES.
    [ -n "$_wok" ] || return 1
    case " $POOL_IFACES " in *" $_wok "*) return 0 ;; esac
    set -f; _worc=1
    for _wou in $WAN_URLS; do
        # shellcheck disable=SC2086
        _woc="$(curl -4 -s -o /dev/null -w '%{http_code}' --interface "$_wok" \
                --connect-timeout 5 --max-time 10 "$_wou" 2>/dev/null)"
        case "$_woc" in 200|204) _worc=0; break ;; esac
    done
    set +f
    return "$_worc"
}
health() {
    set -f; _hrc=1
    for _hu in $HEALTH_URLS; do
        # shellcheck disable=SC2086
        _hc="$(curl -4 -s -o /dev/null $TLS_FLAGS -w '%{http_code}' --interface "$1" \
               --connect-timeout "$HEALTH_TIMEOUT" --max-time "$((HEALTH_TIMEOUT * 2))" "$_hu" 2>/dev/null)"
        case "$_hc" in 200|204) _hrc=0; break ;; esac
    done
    set +f
    return "$_hrc"
}
health_retry() {
    _hrk=0
    while [ "$_hrk" -lt "$HEALTH_TRIES" ] && [ "$RUNNING" = 1 ]; do
        health "$1" && return 0
        _hrk=$((_hrk + 1))
        [ "$_hrk" -lt "$HEALTH_TRIES" ] && [ "$RUNNING" = 1 ] && sleep "$HEALTH_RETRY"
    done
    return 1
}
pool_healthy() {
    for _phf in $POOL_IFACES; do health "$_phf" && return 0; done
    return 1
}
speed_ip_refresh() {
    _srw="$(wan_dev)"; [ -n "$_srw" ] || return 1
    # shellcheck disable=SC2086
    _srip="$(curl -4 -s -o /dev/null $TLS_FLAGS --interface "$_srw" --connect-timeout 5 \
             --max-time 8 -w '%{remote_ip}' "https://$SPEED_HOST/__down?bytes=1" 2>/dev/null)"
    case "$_srip" in *.*.*.*) SPEED_IP="$_srip"; return 0 ;; esac
    return 1
}
# Коды возврата speed:
#   0 -- замер выполнен, скорость >= порога
#   1 -- замер выполнен, сервер МЕДЛЕННЫЙ (или передано 0 байт при HTTP 200)
#   2 -- замер НЕ СОСТОЯЛСЯ: узел замера недоступен/заблокирован (код 000, нет
#        вывода curl) или ответил HTTP-ошибкой. Это не вина проверяемой страны:
#        вызывающий не должен ни увеличивать счётчик, ни бракуровать страну.
speed() {
    [ -n "$SPEED_IP_FIXED" ] && SPEED_IP="$SPEED_IP_FIXED"
    [ -n "$SPEED_IP" ] || speed_ip_refresh || true
    _spres=""
    [ -n "$SPEED_IP" ] && _spres="--resolve $SPEED_HOST:443:$SPEED_IP"
    # shellcheck disable=SC2086
    _spo="$(curl -4 -s -o /dev/null $TLS_FLAGS $_spres --interface "$1" \
            --connect-timeout 5 --max-time "$SPEED_WINDOW" \
            -w '%{http_code} %{speed_download} %{size_download}' \
            "https://$SPEED_HOST/__down?bytes=$SPEED_BYTES" 2>/dev/null)"
    # curl exit 28 (обрыв по окну) НЕ отказ: скорость измерена
    # shellcheck disable=SC2086
    set -- $_spo
    if [ "$#" -lt 3 ]; then
        LAST_SPEED=0
        # узел замера недоступен: сбрасываем кэш IP, чтобы следующий замер
        # заново определил адрес (устаревший IP не должен «убивать» все страны)
        [ -n "$SPEED_IP_FIXED" ] || SPEED_IP=""
        return 2
    fi
    _spc="$1"; _sps="${2%%.*}"; _spz="${3%%.*}"
    case "$_sps" in ''|*[!0-9]*) _sps=0 ;; esac
    case "$_spz" in ''|*[!0-9]*) _spz=0 ;; esac
    LAST_SPEED=$((_sps / 1024))
    if [ "$_spc" != 200 ]; then
        [ "$_spc" = 000 ] && [ -z "$SPEED_IP_FIXED" ] && SPEED_IP=""
        return 2
    fi
    [ "$_spz" -gt 0 ] || return 1
    [ "$LAST_SPEED" -ge "$MIN_SPEED_KBPS" ] || return 1
    return 0
}

st_get() { [ -f "$STATE" ] && sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -n1; }
st_set() {
    _sttmp="$STATE.$$"
    { [ -f "$STATE" ] && grep -v "^$1=" "$STATE" 2>/dev/null; printf '%s=%s\n' "$1" "$2"; } > "$_sttmp" && mv -f "$_sttmp" "$STATE"
    rm -f "$_sttmp" 2>/dev/null
}
host_key() { printf '%s' "$1" | tr '.' '_'; }
mark_good() { st_set "speed_$(host_key "$1")" "$LAST_SPEED"; st_set "dead_$(host_key "$1")" 0; }
# Страна годна по health, но скорость измерить не удалось: cooldown снимаем,
# сохранённую скорость не трогаем.
mark_ok_nospeed() { st_set "dead_$(host_key "$1")" 0; }
mark_dead() { st_set "dead_$(host_key "$1")" "$(( $(date +%s) + DEAD_TTL ))"; }
host_dead() { _hd="$(st_get "dead_$(host_key "$1")")"; [ -n "$_hd" ] && [ "$_hd" -gt "$(date +%s)" ]; }
clear_dead() {
    [ -f "$STATE" ] || return 0
    _cdtmp="$STATE.$$"
    grep -v '^dead_' "$STATE" > "$_cdtmp" 2>/dev/null
    mv -f "$_cdtmp" "$STATE" 2>/dev/null
    rm -f "$_cdtmp" 2>/dev/null
    return 0
}

candidates() {
    _cexcl="$(used_hosts "$1")"; _ci=0; _clist=""; _cnow="$(date +%s)"
    # ручной --rotate обязан сменить страну: текущая исключается всегда
    [ "$ROTATE_EXCL_SELF" = 1 ] && _cexcl="$_cexcl
$(cur_host "$1")"
    while [ "$_ci" -lt "$SERVER_N" ]; do
        _ch="$(srv_host "$_ci")"
        if [ -n "$_ch" ] && valid_host "$_ch" && ! printf '%s\n' "$_cexcl" | grep -qx "$_ch"; then
            _cd="$(st_get "dead_$(host_key "$_ch")")"
            if [ -z "$_cd" ] || [ "$_cd" -le "$_cnow" ]; then
                _csc="$(st_get "speed_$(host_key "$_ch")")"
                [ -n "$_csc" ] || _csc=999999
                _clist="$_clist$_csc $_ch
"
            fi
        fi
        _ci=$((_ci + 1))
    done
    printf '%s' "$_clist" | sort -rn | awk '{print $2}'
    return 0
}

# Запись endpoint'а в UCI. Значения проверяются ДО попадания в `uci batch`:
# перевод строки в port/host добавил бы произвольную команду set от root.
apply_endpoint() {
    _aeif="$1"; _aeh="$2"; _aep="$3"; _aer="$(peer_ref "$_aeif")"
    [ -n "$_aer" ] || return 1
    valid_host "$_aeh" || { loge "$_aeif: недопустимый endpoint '$_aeh'"; return 1; }
    valid_port "$_aep" || { loge "$_aeif: недопустимый порт '$_aep' ($_aeh)"; return 1; }
    if [ "$(pget "$_aer" endpoint_host)" = "$_aeh" ] && \
       [ "$(pget "$_aer" endpoint_port)" = "$_aep" ] && \
       [ "$(pget "$_aer" disabled)" != 1 ]; then
        return 0
    fi
    { printf 'set network.%s.endpoint_host=%s\n' "$_aer" "$_aeh"
      printf 'set network.%s.endpoint_port=%s\n' "$_aer" "$_aep"
      printf 'set network.%s.disabled=0\n' "$_aer"
      printf 'commit network\n'; } | uci -q batch >/dev/null 2>&1
}
apply_host() {
    _ahif="$1"; _ahh="$2"; _ahp=443; _ahi=0
    while [ "$_ahi" -lt "$SERVER_N" ]; do
        [ "$(srv_host "$_ahi")" = "$_ahh" ] && _ahp="$(srv_port "$_ahi")"
        _ahi=$((_ahi + 1))
    done
    apply_endpoint "$_ahif" "$_ahh" "$_ahp"
}
wait_up() {
    _wuk=0
    while [ "$_wuk" -lt 20 ] && [ "$RUNNING" = 1 ]; do
        ip link show dev "$1" >/dev/null 2>&1 && [ -n "$(iface_addr "$1")" ] && return 0
        sleep 1; _wuk=$((_wuk + 1))
    done
    return 1
}
bounce() {
    ifdown "$1" >/dev/null 2>&1
    _bk=0
    while [ "$_bk" -lt 10 ] && [ "$RUNNING" = 1 ]; do
        ip link show dev "$1" >/dev/null 2>&1 || break
        [ -n "$(iface_addr "$1")" ] || break
        sleep 1; _bk=$((_bk + 1))
    done
    ifup "$1" >/dev/null 2>&1
    wait_up "$1" || { loge "$1 не поднялся"; return 1; }
    probe_up "$1" || { loge "$1: проверочный маршрут не создан (apk add ip-full)"; return 1; }
    probe_ok "$1"
}

# Возврат интерфейса на прежнюю страну, если перебор не нашёл годной:
# иначе интерфейс остался бы на последнем проверенном, заведомо нерабочем хосте.
rotate_restore() {
    [ -n "$2" ] || return 0
    [ "$(cur_host "$1")" = "$2" ] && return 0
    logw "$1: возвращаю прежнюю страну $2"
    apply_endpoint "$1" "$2" "$3" || return 1
    [ "$RUNNING" = 1 ] || return 0
    bounce "$1" || true
    return 0
}

rotate() {
    _rif="$1"; _rtries=0
    _roh="$(cur_host "$_rif")"
    _rop="$(pget "$(peer_ref "$_rif")" endpoint_port)"; [ -n "$_rop" ] || _rop=443
    _rcands="$(candidates "$_rif")"
    if [ -z "$_rcands" ]; then
        logw "$_rif: свободных стран нет, сбрасываю cooldown"
        clear_dead
        _rcands="$(candidates "$_rif")"
    fi
    [ -n "$_rcands" ] || { logw "$_rif: список стран пуст"; return 1; }
    for _rh in $_rcands; do
        [ "$RUNNING" = 1 ] || { rotate_restore "$_rif" "$_roh" "$_rop"; logw "$_rif: перебор прерван по сигналу"; return 1; }
        [ "$_rtries" -ge "$MAX_TRIES" ] && break
        _rtries=$((_rtries + 1))
        log "$_rif: пробую $_rh"
        apply_host "$_rif" "$_rh" || continue
        bounce "$_rif" || { mark_dead "$_rh"; continue; }
        if ! health_retry "$_rif"; then logw "$_rif: $_rh не отвечает"; mark_dead "$_rh"; continue; fi
        speed "$_rif"; _rsp=$?
        case "$_rsp" in
            0) mark_good "$_rh"
               log "$_rif: $_rh годен, ${LAST_SPEED} KB/s"
               return 0 ;;
            2) mark_ok_nospeed "$_rh"
               logw "$_rif: $_rh отвечает, но замер скорости не состоялся (узел замера недоступен) -- принят по health"
               return 0 ;;
            *) logw "$_rif: $_rh медленный (${LAST_SPEED} KB/s)"
               mark_dead "$_rh" ;;
        esac
    done
    logw "$_rif: ни одна страна не прошла проверку за $_rtries попыток"
    rotate_restore "$_rif" "$_roh" "$_rop"
    return 1
}

preflight() {
    for _pb in uci ip curl ifup ifdown logger flock sleep sort tr; do
        command -v "$_pb" >/dev/null 2>&1 || { loge "Нет утилиты '$_pb'"; return 1; }
    done
    if [ "$POOL_N" -gt "$POOL_MAX" ]; then
        loge "Пул больше $POOL_MAX интерфейсов не поддерживается: не хватит проверочных правил (приоритеты 200..221)"
        return 1
    fi
    POOL_IFACES=""; _pfkeys=""; _pfhosts=""; _pfi=0
    while [ "$_pfi" -lt "$POOL_N" ]; do
        _pfif="$(pool_iface "$_pfi")"
        valid_name "$_pfif" || { loge "Недопустимое имя интерфейса '$_pfif'"; return 1; }
        uci -q get "network.$_pfif" >/dev/null 2>&1 || { loge "Интерфейс $_pfif отсутствует в network"; return 1; }
        [ "$(peer_count "$_pfif")" = 1 ] || { loge "$_pfif: ожидается ровно один peer"; return 1; }
        set_pr "$_pfif" "$(peer_ref "$_pfif")"
        [ "$(pget "$(peer_ref "$_pfif")" disabled)" = 1 ] && { loge "$_pfif: peer выключен"; return 1; }
        [ "$(pget "$(peer_ref "$_pfif")" route_allowed_ips)" = 1 ] && logw "$_pfif: route_allowed_ips=1 перехватит default route; для Forkop нужно 0"
        [ -n "$(uci -q get "network.$_pfif.addresses")" ] || { loge "$_pfif: не задан addresses"; return 1; }
        _pfkeys="$_pfkeys$(uci -q get "network.$_pfif.private_key")
"
        _pfhosts="$_pfhosts$(cur_host "$_pfif")
"
        POOL_IFACES="$POOL_IFACES $_pfif"
        _pfi=$((_pfi + 1))
    done
    [ "$(printf '%s' "$_pfkeys" | sort -u | grep -c '^')" = "$POOL_N" ] || {
        loge "У интерфейсов пула совпадают private_key: сервер держит одну сессию на ключ. Каждому нужен свой ключ."
        return 1; }
    [ "$(printf '%s' "$_pfhosts" | sort -u | grep -c '^')" = "$POOL_N" ] || {
        loge "Страны пула повторяются (одинаковый endpoint_host). Задайте интерфейсам разные страны."
        return 1; }
    _pfi=0
    while [ "$_pfi" -lt "$SERVER_N" ]; do
        valid_host "$(srv_host "$_pfi")" || logw "server #$_pfi: недопустимый host, страна пропускается"
        valid_port "$(srv_port "$_pfi")" || logw "server #$_pfi: недопустимый port ($(srv_host "$_pfi"))"
        _pfi=$((_pfi + 1))
    done
    # Снимаем правила/таблицы, оставшиеся после аварийного завершения прошлого
    # запуска, иначе они навсегда занимают приоритеты и таблицы.
    probe_cleanup
    _pfi=0
    while [ "$_pfi" -lt "$POOL_N" ]; do
        _pfif="$(pool_iface "$_pfi")"
        pick_probe "$_pfif" || { loge "$_pfif: нет свободной таблицы/приоритета для проверок"; return 1; }
        _pfi=$((_pfi + 1))
    done
    log "Старт v$VERSION пул:$POOL_IFACES стран=$SERVER_N порог=${MIN_SPEED_KBPS}KB/s TLS=${TLS_MAX}"
    return 0
}

# acquire_lock [manual]: в режиме manual (--once/--rotate) занятая блокировка --
# ошибка (код 2): команда НЕ выполнена, потому что работает служба.
acquire_lock() {
    exec 9>"$LOCK" || die "Не открыть $LOCK"
    if ! flock -n 9; then
        if [ "${1:-}" = manual ]; then
            loge "Работает служба awg-pool и держит блокировку: команда не выполнена. Остановите службу (/etc/init.d/awg-pool stop) и повторите."
            exit 2
        fi
        logw "Другой экземпляр работает"
        exit 0
    fi
}
# 9>&- : дочерний sleep не должен наследовать дескриптор блокировки, иначе
# после SIGKILL демона осиротевший sleep держал бы lock до конца паузы.
nap() { sleep "$1" 9>&- & NAP_PID=$!; wait "$NAP_PID" 2>/dev/null; NAP_PID=""; }
on_signal() { RUNNING=0; [ -n "$NAP_PID" ] && kill "$NAP_PID" 2>/dev/null; }
on_exit() {
    for _if in $POOL_IFACES; do
        probe_down "$_if"
        if ! ip link show dev "$_if" >/dev/null 2>&1 || [ -z "$(iface_addr "$_if")" ]; then
            ifup "$_if" >/dev/null 2>&1
        fi
    done
    return 0
}

bring_up_pool() {
    for _if in $POOL_IFACES; do
        if ! ip link show dev "$_if" >/dev/null 2>&1 || [ -z "$(iface_addr "$_if")" ]; then
            ifup "$_if" >/dev/null 2>&1
            wait_up "$_if" || { loge "$_if не поднялся"; continue; }
        fi
        probe_up "$_if" || loge "$_if: проверочный маршрут не создан (apk add ip-full)"
    done
}

# Проверка рабочего интерфейса за один цикл. Счётчики:
#   FAILS  -- подряд неудачные health-проверки (порог FAIL_THRESHOLD)
#   SFAILS -- неудачные ЗАМЕРЫ СКОРОСТИ (порог SPEED_FAIL_THRESHOLD);
#             health-успех между замерами его НЕ сбрасывает -- иначе при
#             speed_every>1 медленный сервер никогда не отбраковывался бы.
#             Замер, который не состоялся (speed вернул 2), счётчик не меняет.
# Возврат: 0 -- всё в порядке/ждём, 1 -- пора перебирать страну.
check_primary() {
    _cpif="$(pool_iface 0)"
    if health "$_cpif"; then
        FAILS=0
        if [ "$SPEED_EVERY" -gt 0 ] && [ $((_cyc % SPEED_EVERY)) = 0 ]; then
            speed "$_cpif"; _cps=$?
            if [ "$_cps" = 1 ]; then sleep 3; speed "$_cpif"; _cps=$?; fi
            case "$_cps" in
                0) mark_good "$(cur_host "$_cpif")"
                   SFAILS=0 ;;
                2) logw "$_cpif: замер скорости не состоялся (узел замера недоступен), пропуск" ;;
                *) SFAILS=$((SFAILS + 1))
                   logw "$_cpif: скорость ниже порога (${LAST_SPEED} KB/s), $SFAILS/$SPEED_FAIL_THRESHOLD"
                   [ "$SFAILS" -ge "$SPEED_FAIL_THRESHOLD" ] && return 1 ;;
            esac
        fi
        return 0
    fi
    FAILS=$((FAILS + 1))
    logw "$_cpif: проверка не пройдена ($FAILS/$FAIL_THRESHOLD)"
    [ "$FAILS" -ge "$FAIL_THRESHOLD" ] && return 1
    return 0
}

# Обслуживание резервов: порог из STANDBY_THRESHOLD подряд неудач,
# cross-check и собственный cooldown на интерфейс (ключ sweep_<iface>).
standby_check() {
    _sb=$((_sb + 1)); _sbi=$((_sb % (POOL_N - 1) + 1))
    _sbs="$(pool_iface "$_sbi")"
    if health "$_sbs"; then set_sf "$_sbs" 0; return 0; fi
    _sbn=$(( $(get_sf "$_sbs") + 1 )); set_sf "$_sbs" "$_sbn"
    if [ "$_sbn" -lt "$STANDBY_THRESHOLD" ]; then
        logw "резерв $_sbs: проверка не пройдена ($_sbn/$STANDBY_THRESHOLD)"
        return 0
    fi
    if [ "$CROSS_CHECK" = 1 ] && ! pool_healthy; then
        logw "резерв $_sbs: ни один интерфейс пула не отвечает, перебор пропущен"
        set_sf "$_sbs" 0
        return 0
    fi
    _sbnow="$(date +%s)"; _sblast="$(st_get "sweep_$_sbs")"
    if [ -n "$_sblast" ] && [ $((_sbnow - _sblast)) -lt "$SWEEP_COOLDOWN" ]; then
        logw "резерв $_sbs: пауза перед перебором"
        return 0
    fi
    logw "резерв $_sbs нездоров, подбираю страну"
    mark_dead "$(cur_host "$_sbs")"
    rotate "$_sbs" || true
    st_set "sweep_$_sbs" "$(date +%s)"
    set_sf "$_sbs" 0
    return 0
}

cmd_status() {
    load_config || { echo "Пул не настроен: ${CFG_REASON:-нужны >=1 секция pool и >=2 server} ($CFG)"; return 1; }
    printf 'awg-pool %s\n' "$VERSION"
    printf 'порог скорости : %s KB/s\n' "$MIN_SPEED_KBPS"
    printf 'макс. TLS      : %s\n' "$TLS_MAX"
    printf 'cross-check    : %s\n' "$CROSS_CHECK"
    printf 'стран в пуле   : %s\n' "$SERVER_N"
    _sti=0
    while [ "$_sti" -lt "$POOL_N" ]; do
        _stif="$(pool_iface "$_sti")"; set_pr "$_stif" "$(peer_ref "$_stif")"
        printf '%-6s %-24s ipv4=%-16s table=%s\n' \
            "$_stif" "$(cur_host "$_stif")" "$(iface_addr "$_stif")" "$(tbl_for "$_stif")"
        _sti=$((_sti + 1))
    done
    printf 'страны:\n'
    _sti=0
    while [ "$_sti" -lt "$SERVER_N" ]; do
        _sth="$(srv_host "$_sti")"
        printf '  %-24s speed=%-8s %s\n' "$_sth" \
            "$(st_get "speed_$(host_key "$_sth")")" "$(host_dead "$_sth" && echo cooldown || echo ok)"
        _sti=$((_sti + 1))
    done
    return 0
}

cmd_once() {
    acquire_lock manual
    load_config || die "Пул не настроен"
    preflight || die "Preflight не пройден"
    trap on_signal TERM INT
    trap on_exit EXIT
    bring_up_pool
    wan_ok || { logw "WAN недоступен"; exit 0; }
    _op="$(pool_iface 0)"
    if health "$_op"; then
        speed "$_op"; _ops=$?
        case "$_ops" in
            0) mark_good "$(cur_host "$_op")"; log "$_op исправен (${LAST_SPEED} KB/s)"; exit 0 ;;
            2) log "$_op исправен (замер скорости не состоялся: узел замера недоступен)"; exit 0 ;;
        esac
    fi
    if [ "$CROSS_CHECK" = 1 ] && [ "$POOL_N" -gt 1 ] && ! pool_healthy; then
        logw "Ни один интерфейс пула не отвечает. Вероятна блокировка проверочных адресов или отказ WAN — перебор пропущен. Проверьте health_urls и tls_max."
        exit 0
    fi
    mark_dead "$(cur_host "$_op")"
    rotate "$_op"; exit $?
}

cmd_rotate() {
    valid_name "$1" || die "Недопустимое имя интерфейса '$1'"
    acquire_lock manual
    load_config || die "Пул не настроен"
    _cri=0; _crfound=0
    while [ "$_cri" -lt "$POOL_N" ]; do
        [ "$1" = "$(pool_iface "$_cri")" ] && _crfound=1
        _cri=$((_cri + 1))
    done
    [ "$_crfound" = 1 ] || die "Интерфейс '$1' не входит в пул"
    preflight || die "Preflight не пройден"
    trap on_signal TERM INT
    trap on_exit EXIT
    bring_up_pool
    ROTATE_EXCL_SELF=1
    rotate "$1"; exit $?
}

cmd_daemon() {
    QUIET=1
    acquire_lock
    trap on_signal TERM INT
    trap on_exit EXIT
    _w=0
    while [ "$RUNNING" = 1 ]; do
        if load_config && preflight; then break; fi
        _w=$((_w + 1))
        [ $((_w % 10)) = 1 ] && logw "Конфигурация не готова: ${CFG_REASON:-см. сообщения выше}; жду 60 с"
        nap 60
    done
    [ "$RUNNING" = 1 ] || { log "Остановлен до настройки"; exit 0; }
    bring_up_pool
    _cyc=0; _last_sweep=0; _sb=0; FAILS=0; SFAILS=0
    while [ "$RUNNING" = 1 ]; do
        _cyc=$((_cyc + 1))
        if [ -z "$WAN_CACHED" ] || [ $((_cyc % WAN_REFRESH_EVERY)) = 0 ]; then
            wan_refresh
        fi
        if [ $((_cyc % PROBE_CHECK_EVERY)) = 0 ]; then
            for _if in $POOL_IFACES; do probe_ok "$_if" || probe_up "$_if" || true; done
        fi
        if ! wan_ok; then
            logw "WAN недоступен (нет default-маршрута или не отвечают wan_urls), проверки пропущены"
            FAILS=0; SFAILS=0
            nap "$CHECK_INTERVAL"; continue
        fi
        if ! check_primary; then
            _dp="$(pool_iface 0)"
            if [ "$CROSS_CHECK" = 1 ] && [ "$POOL_N" -gt 1 ] && ! pool_healthy; then
                logw "Ни один интерфейс пула не отвечает. Вероятна блокировка проверочных адресов или отказ WAN — перебор пропущен, трафик не переключаю. Проверьте health_urls и tls_max."
                FAILS=0; SFAILS=0
                nap "$CHECK_INTERVAL"; continue
            fi
            _dnow="$(date +%s)"
            if [ $((_dnow - _last_sweep)) -lt "$SWEEP_COOLDOWN" ]; then
                logw "пауза перед перебором"
            else
                mark_dead "$(cur_host "$_dp")"
                rotate "$_dp" || true
                _last_sweep="$(date +%s)"; FAILS=0; SFAILS=0
            fi
        fi
        if [ "$RUNNING" = 1 ] && [ "$POOL_N" -gt 1 ] && [ "$STANDBY_EVERY" -gt 0 ] && [ $((_cyc % STANDBY_EVERY)) = 0 ]; then
            standby_check
        fi
        nap "$CHECK_INTERVAL"
    done
    log "Остановлен по сигналу"
    exit 0
}

case "${1:-}" in
    --daemon|"") cmd_daemon ;;
    --once) cmd_once ;;
    --status) cmd_status ;;
    --rotate) [ -n "${2:-}" ] || die "Использование: $0 --rotate <iface>"; cmd_rotate "$2" ;;
    --version) echo "$VERSION" ;;
    --help|-h) echo "awg-pool $VERSION: --daemon | --once | --status | --rotate IFACE | --version" ;;
    *) echo "awg-pool $VERSION: --daemon | --once | --status | --rotate IFACE | --version"; exit 1 ;;
esac
