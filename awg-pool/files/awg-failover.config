config settings 'main'
    option check_interval '20'
    option fail_threshold '3'
    option speed_fail_threshold '2'
    option health_timeout '5'
    option health_tries '3'
    option health_retry '2'
    option health_urls 'https://8.8.8.8/resolve?name=example.com&type=A https://8.8.4.4/resolve?name=example.com&type=A https://1.1.1.1/cdn-cgi/trace'
    option wan_urls 'http://www.msftconnecttest.com/connecttest.txt http://detectportal.firefox.com/success.txt'
    option tls_max '1.2'
    option cross_check '1'
    option min_speed_kbps '200'
    option speed_every '30'
    option speed_bytes '2000000'
    option speed_window '8'
    option speed_host 'speed.cloudflare.com'
    option sweep_cooldown '90'
    option dead_ttl '600'
    option standby_every '15'
    option max_tries '4'
    option probe_check_every '5'
    option wan_refresh_every '15'
