#!/bin/sh /etc/rc.common
# shellcheck shell=sh
# shellcheck disable=SC2034
# START/STOP/USE_PROCD читает /etc/rc.common (подтягивается через shebang),
# а не этот файл. ShellCheck этого не видит, поэтому SC2034 отключён файлово.

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/awg-pool --daemon
    procd_set_param respawn 3600 10 0
    # шаг ротации (bounce + health_retry + speed) может занимать >60 с;
    # короткий term_timeout приводил к SIGKILL без on_exit (утечка правил)
    procd_set_param term_timeout 120
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# Перезапуск службы при применении конфигурации (LuCI «Save & Apply» или
# `uci commit` + reload_config). procd для неизменившейся команды экземпляр
# не перезапускает, поэтому reload делается явным stop+start: демон читает
# конфигурацию только при старте.
service_triggers() {
    procd_add_reload_trigger "awg-failover"
}

reload_service() {
    stop
    start
}
